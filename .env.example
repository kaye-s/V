# Copy this file to `.env` in the project root (same folder as `manage.py`).
# Fill in real values locally. Never commit `.env` or paste secrets into README/chat.

SECRET_KEY=replace-with-a-long-random-string
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_database_user
DB_PASS=your_database_password
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_REPORT_MODEL=gpt-4.1-mini
OPENAI_MODEL_CHOICES=gpt-5.5,gpt-5.4,gpt-5.4-mini
MANAGER_SETUP_CODE=your-secret-manager-registration-code
